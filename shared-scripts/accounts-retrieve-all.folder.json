{
  "name": "accounts retrieve-all",
  "item": [
    {
      "name": "Fetch customer accounts with balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// \u2500\u2500 Retrieve all customer accounts \u2014 Test Script \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "const plaintext = pm.environment.get('DECRYPTED_RESPONSE');",
              "let json;",
              "",
              "// \u2500\u2500 0. Parse decrypted response \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "try {",
              "  json = JSON.parse(plaintext);",
              "} catch (e) {",
              "  pm.test('Response is valid JSON', () =>",
              "    pm.expect.fail('Could not parse decrypted response: ' + e.message)",
              "  );",
              "  return;",
              "}",
              "",
              "",
              "// \u2500\u2500 1. TOP-LEVEL ENVELOPE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is within acceptable range\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Envelope has required top-level keys\", function () {",
              "    pm.expect(json).to.have.all.keys(\"message\", \"success\", \"data\", \"errors\");",
              "});",
              "",
              "pm.test(\"message is 'Request Successfully Treated'\", function () {",
              "    pm.expect(json.message).to.eql(\"Request Successfully Treated\");",
              "});",
              "",
              "pm.test(\"success flag is true\", function () {",
              "    pm.expect(json.success).to.be.true;",
              "});",
              "",
              "pm.test(\"errors is null on successful response\", function () {",
              "    pm.expect(json.errors).to.be.null;",
              "});",
              "",
              "",
              "// \u2500\u2500 2. DATA ARRAY STRUCTURE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "pm.test(\"data is a non-empty array\", function () {",
              "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"Each account object has all required keys\", function () {",
              "    const accounts = json.data;",
              "    const requiredKeys = [",
              "        \"accountNumber\",",
              "        \"accountName\",",
              "        \"currency\",",
              "        \"accountType\",",
              "        \"withdrawalAmount\",",
              "        \"availableBalance\",",
              "        \"ledgerBalance\",",
              "        \"inflowTotal\",",
              "        \"outflowTotal\"",
              "    ];",
              "",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account, `Account at index ${index}`).to.have.all.keys(...requiredKeys);",
              "    });",
              "});",
              "",
              "",
              "// \u2500\u2500 3. FIELD TYPE & VALUE ASSERTIONS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "pm.test(\"accountNumber is a non-empty string for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account.accountNumber, `Index ${index} - accountNumber`).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "pm.test(\"accountName is a non-empty string for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account.accountName, `Index ${index} - accountName`).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "pm.test(\"currency is a valid 3-letter ISO code for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account.currency, `Index ${index} - currency`).to.be.a(\"string\").and.match(/^[A-Z]{3}$/);",
              "    });",
              "});",
              "",
              "pm.test(\"accountType is a non-empty string for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account.accountType, `Index ${index} - accountType`).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "pm.test(\"withdrawalAmount is a string or number for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(",
              "            [\"string\", \"number\"].includes(typeof account.withdrawalAmount),",
              "            `Index ${index} - withdrawalAmount type`",
              "        ).to.be.true;",
              "    });",
              "});",
              "",
              "pm.test(\"availableBalance is a string or number for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(",
              "            [\"string\", \"number\"].includes(typeof account.availableBalance),",
              "            `Index ${index} - availableBalance type`",
              "        ).to.be.true;",
              "    });",
              "});",
              "",
              "pm.test(\"ledgerBalance is a string or number for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(",
              "            [\"string\", \"number\"].includes(typeof account.ledgerBalance),",
              "            `Index ${index} - ledgerBalance type`",
              "        ).to.be.true;",
              "    });",
              "});",
              "",
              "",
              "// \u2500\u2500 4. INFLOW / OUTFLOW (nullable) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "pm.test(\"inflowTotal is null or a valid string/number for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        if (account.inflowTotal !== null) {",
              "            pm.expect(",
              "                [\"string\", \"number\"].includes(typeof account.inflowTotal),",
              "                `Index ${index} - inflowTotal type`",
              "            ).to.be.true;",
              "        } else {",
              "            pm.expect(account.inflowTotal, `Index ${index} - inflowTotal`).to.be.null;",
              "        }",
              "    });",
              "});",
              "",
              "pm.test(\"outflowTotal is null or a valid string/number for each account\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        if (account.outflowTotal !== null) {",
              "            pm.expect(",
              "                [\"string\", \"number\"].includes(typeof account.outflowTotal),",
              "                `Index ${index} - outflowTotal type`",
              "            ).to.be.true;",
              "        } else {",
              "            pm.expect(account.outflowTotal, `Index ${index} - outflowTotal`).to.be.null;",
              "        }",
              "    });",
              "});",
              "",
              "",
              "// \u2500\u2500 5. MULTI-ACCOUNT SPECIFIC \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
              "",
              "pm.test(\"Each account has a unique accountNumber\", function () {",
              "    const accounts = json.data;",
              "    const numbers = accounts.map(a => a.accountNumber);",
              "    const uniqueNumbers = new Set(numbers);",
              "    pm.expect(uniqueNumbers.size).to.eql(numbers.length);",
              "});",
              "",
              "pm.test(\"All accounts belong to the same currency or have valid individual currencies\", function () {",
              "    const accounts = json.data;",
              "    accounts.forEach(function (account, index) {",
              "        pm.expect(account.currency, `Index ${index} - currency`).to.be.a(\"string\").and.match(/^[A-Z]{3}$/);",
              "    });",
              "});",
              "",
              "",
              "// \u2500\u2500 6. STORE FIRST ACCOUNT FOR CHAINING (optional) \u2500\u2500",
              "",
              "const firstAccount = json.data[0];",
              "if (firstAccount) {",
              "    pm.environment.set(\"senderAccountNumber\", firstAccount.accountNumber);",
              "    pm.environment.set(\"transferCurrency\", firstAccount.currency);",
              "     pm.environment.set(\"senderAccountName\", firstAccount.accountName);",
              "     ",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
