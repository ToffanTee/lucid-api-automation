[
  {
    "listen": "prerequest",
    "script": {
      "type": "text/javascript",
      "packages": {},
      "requests": {},
      "exec": [
        "/**\r",
        " * Postman Collection Pre-request Script \u2014 Lucid Gateways\r",
        " */\r",
        "\r",
        "\r",
        "// \u2500\u2500 0. Data Builder \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "const url = pm.request.url.toString();\r",
        "\r",
        "if (url.includes('/send-bvn-verification-code')) {\r",
        "    // Generate a random 11-digit BVN (Nigerian format: starts 1-9, then 10 digits)\r",
        "    const firstDigit = Math.floor(Math.random() * 9) + 1;\r",
        "    let rest = '';\r",
        "    for (let i = 0; i < 10; i++) rest += Math.floor(Math.random() * 10);\r",
        "    const randomBvn = `${firstDigit}${rest}`;\r",
        "\r",
        "    pm.environment.set('bvn', randomBvn);\r",
        "    // console.log('[Pre-request] Generated random BVN:', randomBvn);\r",
        "}\r",
        "\r",
        "// Encryption logic\r",
        "var CryptoJS = require('crypto-js');\r",
        "\r",
        "const CHARACTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\r",
        "\r",
        "function randomAlphanumeric(length) {\r",
        "    let result = '';\r",
        "    for (let i = 0; i < length; i++) {\r",
        "        result += CHARACTERS[Math.floor(Math.random() * CHARACTERS.length)];\r",
        "    }\r",
        "    return result;\r",
        "}\r",
        "\r",
        "function generateRequestId(key16) {\r",
        "    // 4\u00d74 split, prepend 2 random chars to each \u2192 24 chars total\r",
        "    const parts = [\r",
        "        key16.substring(0, 4),\r",
        "        key16.substring(4, 8),\r",
        "        key16.substring(8, 12),\r",
        "        key16.substring(12, 16),\r",
        "    ];\r",
        "    return parts.map(p => randomAlphanumeric(2) + p).join('');\r",
        "}\r",
        "\r",
        "// \u2500\u2500 1. Read raw JSON body \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "const rawBody = pm.request.body && pm.request.body.raw;\r",
        "if (!rawBody || !rawBody.trim()) {\r",
        "    // console.log('[Pre-request] No raw body found \u2014 skipping encryption.');\r",
        "    return;\r",
        "}\r",
        "\r",
        "// Resolve {{var}} placeholders against environment/collection/global vars\r",
        "const resolvedBody = pm.variables.replaceIn(rawBody);\r",
        "\r",
        "let parsedBody;\r",
        "try {\r",
        "    parsedBody = JSON.parse(resolvedBody);\r",
        "} catch (e) {\r",
        "    // console.error('[Pre-request] Body is not valid JSON \u2014 skipping:', e.message);\r",
        "    // console.error('[Pre-request] Resolved body was:', resolvedBody);\r",
        "    // return;\r",
        "}\r",
        "const plaintext = JSON.stringify(parsedBody);\r",
        "\r",
        "// \u2500\u2500 2. Generate fresh 16-char AES key \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "var aesKey = randomAlphanumeric(16);\r",
        "\r",
        "// \u2500\u2500 3. Embed key into request-id header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "const requestId = generateRequestId(aesKey);\r",
        "pm.request.headers.upsert({ key: 'request-id', value: requestId });\r",
        "\r",
        "// \u2500\u2500 4. AES-CBC encrypt, IV = key, zero-padding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "const keyWA = CryptoJS.enc.Utf8.parse(aesKey);\r",
        "const ivWA = CryptoJS.enc.Utf8.parse(aesKey);\r",
        "const plaintextWA = CryptoJS.enc.Utf8.parse(plaintext);\r",
        "\r",
        "const encrypted = CryptoJS.AES.encrypt(plaintextWA, keyWA, {\r",
        "    iv: ivWA,\r",
        "    mode: CryptoJS.mode.CBC,\r",
        "    padding: CryptoJS.pad.ZeroPadding,\r",
        "});\r",
        "\r",
        "const encryptedB64 = encrypted.toString(); // already base64\r",
        "\r",
        "// \u2500\u2500 5. Replace outgoing body \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "pm.request.body.update(JSON.stringify({ request: encryptedB64 }));\r",
        "\r",
        "// \u2500\u2500 6. Debug \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "// console.log('[Pre-request] AES Key     :', aesKey);\r",
        "// console.log('[Pre-request] request-id  :', requestId);\r",
        "// console.log('[Pre-request] Plaintext   :', plaintext);\r",
        "// console.log('[Pre-request] Ciphertext  :', encryptedB64.substring(0, 60) + '...');"
      ]
    }
  },
  {
    "listen": "test",
    "script": {
      "type": "text/javascript",
      "packages": {},
      "requests": {},
      "exec": [
        "/**\r",
        " * Postman Collection Tests Script \u2014 Lucid Gateway\r",
        " *\r",
        " * Place this in: Collection \u2192 Scripts \u2192 Post-response\r",
        " *\r",
        " * How it works:\r",
        " *   - Reads the response-id header to extract the AES key\r",
        " *   - Decrypts the \"response\" field from the JSON response body\r",
        " *   - Stores the plaintext in DECRYPTED_RESPONSE (environment variable)\r",
        " *   - Renders the decrypted result in the Visualizer tab\r",
        " *\r",
        " * Decryption scheme:\r",
        " *   - response-id is 24 chars: [2 noise][4 key][2 noise][4 key][2 noise][4 key][2 noise][4 key]\r",
        " *   - AES key = chars at positions 2-5, 8-11, 14-17, 20-23\r",
        " *   - Algorithm: AES/CBC/NoPadding, IV = key bytes\r",
        " *   - Response envelope: { \"response\": \"<base64-ciphertext>\", \"key\": \"<ignored>\" }\r",
        " */\r",
        "\r",
        "function extractKeyFromResponseId(responseId24) {\r",
        "    return (\r",
        "        responseId24.substring(2, 6) +\r",
        "        responseId24.substring(8, 12) +\r",
        "        responseId24.substring(14, 18) +\r",
        "        responseId24.substring(20, 24)\r",
        "    );\r",
        "}\r",
        "\r",
        "var rawText = pm.response.text();\r",
        "\r",
        "// console.log('[Post-response] Status      :', pm.response.code, pm.response.status);\r",
        "// console.log('[Post-response] Content-Type:', pm.response.headers.get('Content-Type'));\r",
        "// console.log('[Post-response] Raw body    :', rawText.substring(0, 200) + (rawText.length > 200 ? '...' : ''));\r",
        "\r",
        "var responseId = pm.response.headers.get('response-id');\r",
        "\r",
        "\r",
        "\r",
        "\r",
        "if (!responseId) {\r",
        "    // console.log('[Post-response] No response-id header \u2014 response is not encrypted.');\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', rawText);\r",
        "    pm.test('Response received (unencrypted)', () => pm.expect(pm.response.code).to.be.lessThan(500));\r",
        "    return;\r",
        "}\r",
        "\r",
        "if (responseId.length !== 24) {\r",
        "    // console.error('[Post-response] response-id has unexpected length:', responseId.length, '\u2014 expected 24.');\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', rawText);\r",
        "    return;\r",
        "}\r",
        "\r",
        "var aesKey = extractKeyFromResponseId(responseId);\r",
        "// console.log('[Post-response] response-id :', responseId);\r",
        "// console.log('[Post-response] AES key     :', aesKey);\r",
        "\r",
        "let respJson;\r",
        "try {\r",
        "    respJson = JSON.parse(rawText);\r",
        "} catch (e) {\r",
        "    // console.log('[Post-response] Body is not JSON \u2014 skipping decryption.');\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', rawText);\r",
        "    return;\r",
        "}\r",
        "\r",
        "var cipherB64 = respJson.response;\r",
        "if (!cipherB64) {\r",
        "    // console.log('[Post-response] No \"response\" field in body \u2014 skipping decryption.');\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', rawText);\r",
        "    return;\r",
        "}\r",
        "\r",
        "try {\r",
        "    const key = CryptoJS.enc.Utf8.parse(aesKey);\r",
        "    const iv = CryptoJS.enc.Utf8.parse(aesKey);\r",
        "\r",
        "    const decrypted = CryptoJS.AES.decrypt(cipherB64, key, {\r",
        "        iv,\r",
        "        mode: CryptoJS.mode.CBC,\r",
        "        padding: CryptoJS.pad.NoPadding,\r",
        "    });\r",
        "\r",
        "    let plaintext = decrypted.toString(CryptoJS.enc.Utf8);\r",
        "    plaintext = plaintext.replace(/\\u0000+$/, '').trim();\r",
        "\r",
        "    // console.log('[Post-response] Decrypted   :', plaintext);\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', plaintext);\r",
        "\r",
        "    let formattedResponse = plaintext;\r",
        "    let jsonResponse = null;\r",
        "\r",
        "    try {\r",
        "        jsonResponse = JSON.parse(plaintext);\r",
        "        formattedResponse = JSON.stringify(jsonResponse, null, 2);\r",
        "        pm.environment.set('DECRYPTED_RESPONSE_JSON', formattedResponse);\r",
        "        // console.log('[Post-response] Parsed as JSON successfully.');\r",
        "    } catch (_) {\r",
        "        // console.log('[Post-response] Decrypted value is not JSON \u2014 storing as plain text.');\r",
        "    }\r",
        "\r",
        "    const template = `\r",
        "    <html>\r",
        "    <head>\r",
        "      <style>\r",
        "        * { box-sizing: border-box; margin: 0; padding: 0; }\r",
        "        body {\r",
        "          font-family: 'Menlo', 'Consolas', monospace;\r",
        "          font-size: 13px;\r",
        "          padding: 20px;\r",
        "          background: #1e1e1e;\r",
        "          color: #d4d4d4;\r",
        "        }\r",
        "        .badge {\r",
        "          display: inline-block;\r",
        "          padding: 4px 10px;\r",
        "          border-radius: 4px;\r",
        "          font-weight: bold;\r",
        "          margin-bottom: 14px;\r",
        "        }\r",
        "        .success { background: #2d5a2d; color: #98c379; }\r",
        "        .error   { background: #5a2d2d; color: #e06c75; }\r",
        "        h3 { color: #61afef; margin-bottom: 10px; }\r",
        "        pre {\r",
        "          background: #252526;\r",
        "          border: 1px solid #3c3c3c;\r",
        "          border-radius: 6px;\r",
        "          padding: 14px;\r",
        "          white-space: pre-wrap;\r",
        "          word-wrap: break-word;\r",
        "          line-height: 1.5;\r",
        "        }\r",
        "      </style>\r",
        "    </head>\r",
        "    <body>\r",
        "      <div class=\"badge {{statusClass}}\">{{status}}</div>\r",
        "      <h3>Decrypted Response</h3>\r",
        "      <pre>{{response}}</pre>\r",
        "    </body>\r",
        "    </html>\r",
        "  `;\r",
        "\r",
        "    pm.visualizer.set(template, {\r",
        "        response: formattedResponse,\r",
        "        status: pm.response.code + ' ' + pm.response.status,\r",
        "        statusClass: pm.response.code < 400 ? 'success' : 'error',\r",
        "    });\r",
        "\r",
        "    // \u2500\u2500 Universal assertions (run for every request in the collection) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r",
        "    pm.test('Status code is 2xx', () => {\r",
        "        pm.expect(pm.response.code).to.be.within(200, 299);\r",
        "    });\r",
        "\r",
        "\r",
        "} catch (err) {\r",
        "    // console.error('[Post-response] Decryption error:', err.message);\r",
        "    // console.error('[Post-response] AES key used    :', aesKey);\r",
        "    // console.error('[Post-response] response-id     :', responseId);\r",
        "    pm.environment.set('DECRYPTED_RESPONSE', 'DECRYPTION_FAILED: ' + err.message);\r",
        "\r",
        "    pm.test('Decryption did not throw', () => {\r",
        "        pm.expect.fail('Decryption error: ' + err.message);\r",
        "    });\r",
        "}\r",
        ""
      ]
    }
  }
]
